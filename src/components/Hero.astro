<script>
  // Scale the background grid + symbol pattern up on large screens (e.g. 4K monitors),
  // so the tile keeps roughly the same proportions it has at 1440px instead of
  // shrinking to tiny, hair-thin symbols. At 1440px and below the scale is 1 (unchanged).
  const patterns = document.querySelectorAll("#hero pattern");
  const scalePattern = () => {
    const s = Math.max(1, window.innerWidth / 1440);
    patterns.forEach((p) => p.setAttribute("patternTransform", `scale(${s})`));
  };
  let frame = 0;
  window.addEventListener("resize", () => {
    cancelAnimationFrame(frame);
    frame = requestAnimationFrame(scalePattern);
  });
  scalePattern();
</script>

<style>

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-in {
    animation: fadeIn 0.8s ease-out forwards;
    opacity: 0;
  }

  .animation-delay-200 {
    animation-delay: 0.2s;
  }

  .animation-delay-400 {
    animation-delay: 0.4s;
  }

  .animation-delay-600 {
    animation-delay: 0.6s;
  }
</style>
