  <style>
    .gear {
      transform-box: fill-box;
      transform-origin: center;
    }
    /* Big gear: one turn every 9.6 minutes (576s). The small gear has 13/48 the teeth,
       so it must turn 48/13 times faster (576 x 13 / 48 = 156s) in the opposite direction
       to stay meshed. Keep this ratio exact if you change the speed. */
    .gear-big {
      animation: gear-spin 576s linear infinite;
    }
    .gear-small {
      animation: gear-spin 156s linear infinite reverse;
    }
    @keyframes gear-spin {
      to {
        transform: rotate(360deg);
      }
    }
    @media (prefers-reduced-motion: reduce) {
      .gear-big,
      .gear-small {
        animation: none;
      }
    }
  </style>
