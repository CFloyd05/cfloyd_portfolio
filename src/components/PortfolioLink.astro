---
// Wide button between the hero and About Me that opens the PDF portfolio (/portfolio).
import { siteConfig } from "../config";
---

<section id="portfolio-link" class="px-6 sm:px-8 md:px-10 lg:px-12 pt-6 sm:pt-8 md:pt-10 lg:pt-12">
  <a
    href="/portfolio"
    target="_blank"
    rel="noopener noreferrer"
    class="group flex items-center justify-between gap-4 sm:gap-6 bg-gray-50 hover:bg-white rounded-xl sm:rounded-2xl shadow hover:shadow-xl border border-gray-200 hover:border-gray-300 border-l-[6px] px-5 py-8 sm:px-7 sm:py-10 md:px-9 md:py-12 transition-all duration-300 hover:-translate-y-0.5"
    style={`border-left-color: ${siteConfig.accentColor}`}
  >
    <div>
      <h2 class="text-xl sm:text-2xl md:text-3xl font-bold text-gray-900">
        TL;DR Portfolio
      </h2>
      <p class="mt-2 sm:mt-3 text-sm sm:text-base md:text-lg text-gray-600">
        My experience and projects in a handful of pages. Or, view the full write-ups below.
      </p>
    </div>

    <div class="shrink-0 w-10 h-10 sm:w-12 sm:h-12 md:w-14 md:h-14 rounded-full bg-gray-900 text-white flex items-center justify-center shadow-sm transition-all duration-300 group-hover:bg-gray-700">
      <svg
        class="w-5 h-5 sm:w-6 sm:h-6 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7M17 7H7M17 7V17" />
      </svg>
    </div>
  </a>
</section>
