---
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import About from "../components/About.astro";
import Resume from "../components/Resume.astro";
import Projects from "../components/Projects.astro";
import Experience from "../components/Experience.astro";
import Education from "../components/Education.astro";
import Footer from "../components/Footer.astro";
import BackToTop from "../components/BackToTop.astro";
import { siteConfig } from "../config";
import "../styles/global.css";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={siteConfig.description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;1,100;1,200;1,300;1,400;1,500;1,600;1,700&display=swap"
      rel="stylesheet"
    />
    <title>{siteConfig.name} - {siteConfig.title}</title>
  </head>
  <body>
    <Header />
    <section>
      <Hero />
      <About />
      <Experience />
      <Projects />
      <Education />
      <Resume />
    </section>
    <Footer />
    <BackToTop />
  </body>
</html>

<script>
  const KEY = "homepage-return";

  // Save on tap/click
  document.addEventListener(
    "click",
    (e) => {
      const link = (e.target as HTMLElement).closest("a");
      const href = link?.getAttribute("href");
      if (!link || !href?.startsWith("/")) return; // only links to this site's pages
      sessionStorage.setItem(
        KEY,
        JSON.stringify({ href, offset: link.getBoundingClientRect().top, y: window.scrollY })
      );
    },
    true
  );

  function restore() {
    // Restore when coming back via the Home link, or via the browser back button / swipe
    const viaHomeLink = sessionStorage.getItem("restore-home-scroll") === "1";
    sessionStorage.removeItem("restore-home-scroll");
    const nav = performance.getEntriesByType("navigation")[0] as PerformanceNavigationTiming | undefined;
    const viaBack = nav?.type === "back_forward";
    if (!viaHomeLink && !viaBack) return;

    const saved = JSON.parse(sessionStorage.getItem(KEY) ?? "null");
    if (!saved) return;

    // Where the page needs to scroll to put the card back where it was on screen
    const target = () => {
      const card = document.querySelector(`a[href="${CSS.escape(saved.href)}"]`);
      return card ? window.scrollY + card.getBoundingClientRect().top - saved.offset : saved.y;
    };

    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const behavior: ScrollBehavior = reduceMotion ? "auto" : "smooth";
    const glide = () => window.scrollTo({ top: target(), behavior });

    // Stop correcting as soon as the visitor scrolls themselves
    let userScrolled = false;
    const stop = () => (userScrolled = true);
    ["wheel", "touchstart", "keydown"].forEach((ev) =>
      window.addEventListener(ev, stop, { once: true, passive: true })
    );

    // Glide down once the page has laid out...
    requestAnimationFrame(glide);

    const correct = () => {
      if (!userScrolled && Math.abs(window.scrollY - target()) > 2) glide();
    };
    setTimeout(correct, 1000);
    window.addEventListener("load", () => setTimeout(correct, 300), { once: true });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", restore);
  } else {
    restore();
  }
</script>
